# R project files
^.*\.Rproj$
^\.Rproj\.user$

# Version control - multiple patterns to ensure .git is excluded
.git*
.git/*

# Development files
^\.Rprofile$
data-raw/*$
^examples$
^msigdf_logo\.png$

# Documentation
^README\.md$
^NEWS\.md$
^cran-comments\.md$

# System files
^\.DS_Store$

# GitHub
^\.github$

# Package documentation site
^_pkgdown\.yml$
^docs$
^pkgdown$
^doc$
^Meta$
